{
  "manifest_version": 3,
  "name": "eLMS Email Collector",
  "version": "0.1",
  "description": "List your eLMS courses, pick one, and collect the emails of course participants who made them visible.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": { 
    "default_popup": "popup.html", 
    "default_title": "eLMS Email Collector",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "host_permissions": ["https://elms.uiu.ac.bd/*"]
}
